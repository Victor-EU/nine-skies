{
  "name": "nine-skies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "engine",
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "npm -w app run dev",
    "build": "npm -w app run build",
    "content:validate": "vite-node content/validate.ts",
    "content:sections": "vite-node tools/cutSections.ts",
    "content:cut-key": "vite-node tools/cutKey.ts",
    "check": "npm run typecheck && npm test && npm run content:validate"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.0",
    "yaml": "^2.9.1"
  }
}
