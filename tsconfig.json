{
  "extends": "./tsconfig.base.json",
  "include": [
    "engine/src/**/*.ts",
    "app/src/**/*.ts",
    "content/**/*.ts",
    "test/**/*.ts",
    "*.config.ts",
    "app/src/**/*.d.ts"
  ],
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true
  }
}
